FROM node:22-alpine

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev \
    && addgroup -S -g 10002 mailai \
    && adduser -S -D -H -u 10002 -G mailai -s /sbin/nologin mailai \
    && mkdir -p /config \
    && chown -R mailai:mailai /config /app
COPY --chown=mailai:mailai tools/mail-ai-agent ./tools/mail-ai-agent

USER mailai
EXPOSE 8090
VOLUME ["/config"]
ENV MAIL_AI_ADDR=0.0.0.0:8090
ENV MAIL_AI_MODEL_CONFIG_FILE=/config/model.json
HEALTHCHECK --interval=30s --timeout=3s --retries=3 CMD wget -q -O /dev/null http://127.0.0.1:8090/healthz || exit 1
ENTRYPOINT ["node", "tools/mail-ai-agent/server.mjs"]